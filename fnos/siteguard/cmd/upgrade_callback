#!/bin/bash
#
# 升级文件替换完成后调用，随后系统会重新拉起应用。
# 数据目录与配置随包保留，无需迁移；只补一次权限兜底并记日志。

set -u

LOG_FILE="${TRIM_PKGVAR:-/tmp}/siteguard.log"

# 授权目录列表用冒号分隔，取第一个；Windows 盘符（E:/...）只在本地模拟时出现，不能从第一个冒号截断。
case "${TRIM_DATA_SHARE_PATHS:-}" in
  [A-Za-z]:/*) DATA_DIR="${TRIM_DATA_SHARE_PATHS}" ;;
  *) DATA_DIR="${TRIM_DATA_SHARE_PATHS:-}"; DATA_DIR="${DATA_DIR%%:*}" ;;
esac
[ -n "$DATA_DIR" ] || DATA_DIR="${TRIM_PKGVAR:-/tmp}/data"
mkdir -p "$DATA_DIR" 2>/dev/null

echo "$(date '+%Y-%m-%d %H:%M:%S') - upgrade_callback: to=${TRIM_APPVER:-?} data=${DATA_DIR}" >> "$LOG_FILE" 2>/dev/null
exit 0
