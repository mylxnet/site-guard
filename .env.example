# 网站哨兵环境变量示例（复制为 .env 后按需修改；.env 不入库）
# 端口与数据目录
PORT=8686
DATA_DIR=./data
TZ=Asia/Shanghai
LOG_LEVEL=info

# 网关（飞牛原生应用使用 Unix Socket 与路径前缀，Docker/本机留空）
GATEWAY_PREFIX=
SOCKET_PATH=
FRONTEND_DIST=
ALLOWED_ORIGINS=

# 数据库文件（默认 DATA_DIR/app.db）
DB_FILE=

# 巡检与抓取
MAX_PAGES_PER_SITE=30
ALLOW_PRIVATE_TARGETS=true
FETCH_TIMEOUT_MS=20000
FETCH_MAX_BYTES=5242880
FETCH_RETRIES=1
FETCH_RETRY_DELAY_MS=5000
PAGE_GAP_MS=3000
SCHEDULER_TICK_MS=20000
MAX_CONCURRENCY=2
